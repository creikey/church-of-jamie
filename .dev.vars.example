# Copy to .dev.vars (gitignored) for local development, and set the same values
# as production secrets with `npx wrangler pages secret put <NAME>`.

# ---------------------------------------------------------------- answering questions
# Only the key for the active provider is required — see MODEL in functions/api/ask.ts.

# https://openrouter.ai/settings/keys — used when MODEL is an OpenRouter model (the default)
OPENROUTER_API_KEY=sk-or-v1-...

# https://console.anthropic.com/settings/keys — used when MODEL is a Claude model
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare dashboard → Workers & Pages → the account ID in the right sidebar
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare dashboard → My Profile → API Tokens → Create Token → Custom token,
# with the single permission: Account · Workers AI · Read
CLOUDFLARE_AI_TOKEN=

# ---------------------------------------------------------------- bot challenge (Turnstile)

# https://dash.cloudflare.com → Turnstile → Add widget. Both keys, or neither: with either one
# missing the challenge is not shown and not checked — and since nothing else meters anything,
# that means anyone can help themselves to messages in a loop, as fast as they can send requests.
#
# Cloudflare's always-passes test pair, for local development:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Swap the site key to 2x00000000000000000000AB to see the failure path.
#
# The site key is public — it is served to the browser by /api/me — so it is only kept here to
# keep all the configuration in one file.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
